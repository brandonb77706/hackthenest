# Copy to .env.local (gitignored). Add keys for whichever providers the team uses.
# MongoDB Atlas connection string (ask Brandon). MONGODB_DB defaults to "bridge".
MONGODB_URI=
# MONGODB_DB=bridge

# Base44 AI. The app id is in the Base44 editor URL: /apps/<id>/editor. Not secret.
# Without it, AI features use sample answers.
NEXT_PUBLIC_BASE44_APP_ID=
# Shared secret for the Base44 "invokeLLM" backend function (see base44/README.md). Secret.
# Must match BRIDGE_FUNCTION_SECRET in the Base44 app's secrets. Ask Brandon.
BASE44_FUNCTION_SECRET=
# ElevenLabs key for Read aloud (ask Brandon). Voices are listed in src/lib/voice/voices.ts.
ELEVENLABS_API_KEY=
# Which voice Read aloud uses: "browser" (free, for testing) or "elevenlabs" (uses credits).
# Leave unset: browser voice in `npm run dev`, ElevenLabs when deployed.
# NEXT_PUBLIC_VOICE_PROVIDER=elevenlabs
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# Local desktop web push: matching VAPID key pair, generated once.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# For example mailto:you@example.com
VAPID_SUBJECT=
