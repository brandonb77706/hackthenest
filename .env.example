# Copy to .env.local (gitignored). Add keys for whichever providers the team uses.
# MongoDB Atlas connection string (ask Brandon). MONGODB_DB defaults to "bridge".
MONGODB_URI=
# MONGODB_DB=bridge

# Login (Better Auth). Secret: generate with `openssl rand -base64 32`.
BETTER_AUTH_SECRET=
# Only for a custom domain, e.g. https://bridge.example.com. Leave unset in dev
# (works on localhost, phones on wifi, and tunnels) and on Vercel (login uses the
# addresses Vercel gives the app). See src/lib/auth/siteUrl.ts.
# BETTER_AUTH_URL=
# Google sign-in (optional; the button hides without these). Google Cloud Console >
# APIs & Services > Credentials > OAuth client ID (Web). Redirect URIs:
#   http://localhost:3000/api/auth/callback/google
#   https://hackthenest-one.vercel.app/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Password for the demo logins that `npm run db:seed` creates (jordan@ and sam@example.com).
# DEMO_PASSWORD=

# Base44 AI. The app id is in the Base44 editor URL: /apps/<id>/editor. Not secret.
# Without it, AI features use sample answers.
NEXT_PUBLIC_BASE44_APP_ID=
# Shared secret for the Base44 "invokeLLM" backend function (see base44/README.md). Secret.
# Must match BRIDGE_FUNCTION_SECRET in the Base44 app's secrets. Ask Brandon.
BASE44_FUNCTION_SECRET=
# ElevenLabs key for Read aloud (ask Brandon). Voices are listed in src/lib/voice/voices.ts.
ELEVENLABS_API_KEY=
# Which voice Read aloud uses: "browser" (free, for testing) or "elevenlabs" (uses credits).
# Leave unset to use ElevenLabs (voice: Chris) everywhere. Set to "browser" to use the
# browser's free voice and save ElevenLabs credits while testing.
# NEXT_PUBLIC_VOICE_PROVIDER=browser
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# Kroger production API credentials (server only)
KROGER_CLIENT_ID=
KROGER_CLIENT_SECRET=

# Local desktop web push: matching VAPID key pair, generated once.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# For example mailto:you@example.com
VAPID_SUBJECT=
